#!/bin/zsh
# claude-qwen: run Claude Code against a local GGUF model (llama.cpp / llama-server).
#
#   claude-qwen [claude args]           pick a model, start the server if needed, open Claude Code
#   claude-qwen download [repo] [file]  download a GGUF from Hugging Face (asks if no repo given)
#   claude-qwen models                  list downloaded models
#   claude-qwen setup                   install llama.cpp, link the command, show the sudo rule
#   claude-qwen start | stop | restart  manage the server without opening Claude Code
#   claude-qwen status | log            show status / follow the log
#   claude-qwen version
#   claude-qwen providers               show configured remote providers (~/.config/claude-qwen/providers.conf)
#
# Data (models, logs): the checkout dir in a git clone, otherwise ~/.claude-qwen (override: CLAUDE_QWEN_HOME)
#
# Environment variables:
#   QWEN_MODEL=<n|file-name>   skip the menu          QWEN_CTX=102400   context size
#   QWEN_EFFORT=medium         xhigh|medium|low|none  QWEN_MTP=auto|0|1 MTP speculative decoding
#   QWEN_KEEP=1                keep the server running after the session ends
#   QWEN_BACKEND=<n|name>      skip the backend menu (local or a provider name)
#   QWEN_REMOTE_MODEL=<id>     skip the remote model menu
#   QWEN_VISION=0              don't load <model>.mmproj.gguf (saves ~1 GB; no image input)
#   QWEN_GPU_MB=<MB>           iogpu.wired_limit_mb while the server runs (default: 7/8 of RAM)
#   QWEN_PORT=8088             QWEN_EXTRA="..." extra llama-server arguments
set -u

VERSION="0.2.0"
DIR="${0:A:h}"   # real location of this script (symlinks resolved)
# Data dir: the checkout itself in a git clone (if models/ is next to it), ~/.claude-qwen for brew installs
if [[ -n "${CLAUDE_QWEN_HOME:-}" ]]; then DATA="$CLAUDE_QWEN_HOME"
elif [[ -d "$DIR/models" ]]; then DATA="$DIR"
else DATA="$HOME/.claude-qwen"; fi
mkdir -p "$DATA"
# Patched template: next to the script in a clone, ../share/claude-qwen for brew
TEMPLATE="$DIR/chat_template.jinja"
[[ -f "$TEMPLATE" ]] || TEMPLATE="${DIR:h}/share/claude-qwen/chat_template.jinja"
MODELS_DIR="$DATA/models"
PORT="${QWEN_PORT:-8088}"
CTX="${QWEN_CTX:-102400}"
EFFORT="${QWEN_EFFORT:-medium}"
MTP="${QWEN_MTP:-auto}"
PIDFILE="$DATA/server.pid"
LOG="$DATA/server.log"
SESSIONS="$DATA/sessions"
URL="http://127.0.0.1:$PORT"
ALIAS="local-model"
RAM_MB=$(( $(sysctl -n hw.memsize) / 1048576 ))
GPU_MB="${QWEN_GPU_MB:-$(( RAM_MB * 7 / 8 ))}"

server_up() { curl -sf "$URL/health" >/dev/null 2>&1; }
human() { [[ "$1" == <-> ]] && awk -v n="$1" 'BEGIN{printf "%.1f GB", n/1e9}' || echo "?"; }

# --- GPU wired-memory limit (passwordless if the sudoers rule is installed) --
gpu_limit() { sudo -n /usr/sbin/sysctl "iogpu.wired_limit_mb=$1" >/dev/null 2>&1; }
sudoers_rule() {
  echo "$(whoami) ALL=(root) NOPASSWD: /usr/sbin/sysctl iogpu.wired_limit_mb=$GPU_MB, /usr/sbin/sysctl iogpu.wired_limit_mb=0"
}

# --- Server ----------------------------------------------------------------
stop_server() {
  local pid=""
  [[ -f "$PIDFILE" ]] && pid="$(cat "$PIDFILE")"
  kill -0 "$pid" 2>/dev/null || pid="$(pgrep -f "llama-server.*--port $PORT" | head -1)"
  if [[ -n "$pid" ]]; then
    kill "$pid"
    for i in {1..10}; do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid"
    echo "Server stopped."
    gpu_limit 0
  else
    echo "No server running."
  fi
  rm -f "$PIDFILE"
}

start_server() {
  server_up && return 0
  [[ -f "$MODEL" ]] || { echo "Model not found: $MODEL" >&2; exit 1; }
  command -v llama-server >/dev/null || { echo "llama-server not found. Run: claude-qwen setup" >&2; exit 1; }
  # MTP needs extra GPU memory: enable it if the limit could be raised (or already is high enough)
  if gpu_limit "$GPU_MB" || (( $(sysctl -n iogpu.wired_limit_mb) >= GPU_MB )); then
    [[ "$MTP" == auto ]] && MTP=1
  else
    [[ "$MTP" == 1 ]] && echo "Warning: could not raise the GPU memory limit (see claude-qwen setup); MTP disabled." >&2
    MTP=0
  fi
  local extra=()
  [[ "$MTP" == 1 ]] && extra+=(--spec-type draft-mtp --spec-draft-n-max 3)
  # Vision: <model>.mmproj.gguf next to the model enables image input (QWEN_VISION=0 disables it)
  local mmproj="${MODEL:r}.mmproj.gguf" vision=off
  if [[ -f "$mmproj" && "${QWEN_VISION:-1}" != 0 ]]; then extra+=(--mmproj "$mmproj"); vision=on; fi
  # The stock Qwen3.8 template rejects Claude Code's mid-conversation system messages; use the patched one.
  [[ "${MODEL:t}" == *[Qq]wen3.8* && -f "$TEMPLATE" ]] && extra+=(--chat-template-file "$TEMPLATE")
  echo "Loading ${MODEL:t} (~30-60 s, MTP: $([[ $MTP == 1 ]] && echo on || echo off), vision: $vision)..."
  nohup llama-server \
    -m "$MODEL" --alias "$ALIAS" \
    --host 127.0.0.1 --port "$PORT" \
    -ngl 99 -c "$CTX" -fa on -ctk q8_0 -ctv q8_0 \
    --jinja --reasoning-effort "$EFFORT" \
    --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0 \
    --parallel 1 "${extra[@]}" ${=QWEN_EXTRA:-} \
    >"$LOG" 2>&1 &
  echo $! >"$PIDFILE"
  for i in {1..300}; do
    server_up && { echo "Server ready ($URL)."; return 0; }
    kill -0 "$(cat "$PIDFILE")" 2>/dev/null || { echo "Server crashed, log: $LOG" >&2; tail -20 "$LOG" >&2; gpu_limit 0; exit 1; }
    sleep 1
  done
  echo "Server start timed out, log: $LOG" >&2; exit 1
}

# --- Remote providers (Anthropic-compatible APIs) --------------------------
# ~/.config/claude-qwen/providers.conf, one per line:   <name> <base-url> <key>
#   <key> is env:VAR_NAME or file:/path/to/key.txt  (the key is read at launch, never copied)
PROVIDERS_FILE="${CLAUDE_QWEN_PROVIDERS:-$HOME/.config/claude-qwen/providers.conf}"

list_providers() {
  [[ -f "$PROVIDERS_FILE" ]] || return 0
  local name url key
  while read -r name url key _; do
    [[ -z "$name" || "$name" == \#* ]] && continue
    echo "$name $url $key"
  done < "$PROVIDERS_FILE"
}

read_key() {  # read_key env:VAR | file:/path
  case "$1" in
    env:*)  local v="${1#env:}"; print -r -- "${(P)v:-}" ;;
    file:*) local f="${~1#file:}"
            [[ -r "$f" ]] || { echo "Key file not readable: $f (is the drive mounted?)" >&2; return 1; }
            tr -d '[:space:]' < "$f" ;;
    *)      echo "Unknown key spec '$1' (use env:VAR or file:/path)" >&2; return 1 ;;
  esac
}

# Prints "local" or "<name> <url> <keyspec>"
choose_backend() {
  local provs=("${(@f)$(list_providers)}")
  [[ -z "${provs[1]:-}" ]] && { echo local; return; }
  local pick="${QWEN_BACKEND:-}" i
  if [[ -z "$pick" ]]; then
    {
      echo "Which backend?"
      echo "  1) local  (llama.cpp, models in $MODELS_DIR)"
      for i in {1..${#provs}}; do echo "  $((i+1))) ${provs[$i]%% *}  (${${provs[$i]#* }%% *})"; done
    } >&2
    read "pick?Choice [1]: " </dev/tty
    [[ -z "$pick" ]] && pick=1
  fi
  [[ "$pick" == 1 || "$pick" == local ]] && { echo local; return; }
  if [[ "$pick" == <-> ]]; then
    (( pick >= 2 && pick <= ${#provs} + 1 )) || { echo "Invalid choice: $pick" >&2; exit 1; }
    echo "${provs[$((pick-1))]}"; return
  fi
  for i in {1..${#provs}}; do [[ "${provs[$i]%% *}" == "$pick" ]] && { echo "${provs[$i]}"; return; }; done
  echo "Unknown backend: $pick" >&2; exit 1
}

launch_remote() {  # launch_remote <name> <base-url> <keyspec> [claude args...]
  local name="$1" base="${2%/}" keyspec="$3"; shift 3
  local key; key="$(read_key "$keyspec")" || exit 1
  [[ -n "$key" ]] || { echo "Empty API key for $name ($keyspec)" >&2; exit 1; }
  local listing
  # The key goes to curl via stdin (-K -), not argv, so it never shows up in `ps`. printf is a zsh builtin.
  listing="$(printf 'header = "Authorization: Bearer %s"\n' "$key" | curl -sf -m 30 -K - "$base/v1/models" | python3 -c '
import json,sys
d=json.load(sys.stdin); ms=d.get("data",d) if isinstance(d,dict) else d
for m in ms:
    i=str(m.get("id",""))
    if not i or any(c in i for c in " \t\n\r"): continue
    p=m.get("pricing") or {}
    price="$%s/$%s per M in/out" % (p.get("input_per_m","?"), p.get("output_per_m","?")) if p else ""
    ctx=m.get("context_length"); ctx=f"{int(ctx)//1000}K ctx" if isinstance(ctx,int) else ""
    vis="vision" if m.get("vision") else ""
    print(i+"\t"+"  ".join(x for x in (ctx,price,vis) if x))')" \
    || { echo "Could not list models from $base/v1/models" >&2; exit 1; }
  [[ -n "$listing" ]] || { echo "$name returned no models" >&2; exit 1; }
  local lines=("${(@f)listing}") i pick="${QWEN_REMOTE_MODEL:-}" model=""
  if [[ -z "$pick" ]]; then
    echo "Models on $name (all of them are selectable with /model in this session):"
    for i in {1..${#lines}}; do printf "  %d) %-34s %s\n" $i "${lines[$i]%%$'\t'*}" "${lines[$i]#*$'\t'}"; done
    read "pick?Start with [1]: "
    [[ -z "$pick" ]] && pick=1
  fi
  if [[ "$pick" == <-> ]]; then
    (( pick >= 1 && pick <= ${#lines} )) || { echo "Invalid choice: $pick" >&2; exit 1; }
    model="${lines[$pick]%%$'\t'*}"
  else
    model="$pick"
  fi
  echo "Starting Claude Code on $name / $model"
  # Gateway model discovery registers the provider's /v1/models in the /model picker for this session only.
  ANTHROPIC_BASE_URL="$base" \
  ANTHROPIC_AUTH_TOKEN="$key" \
  ANTHROPIC_MODEL="$model" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="$model" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="$model" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="$model" \
  CLAUDE_CODE_SUBAGENT_MODEL="$model" \
  CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1 \
  CLAUDE_CODE_MAX_CONTEXT_TOKENS="${QWEN_REMOTE_CTX:-1000000}" \
  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    exec claude "$@"
}

# --- Models ----------------------------------------------------------------
list_models() {
  # vision projectors (mmproj / <model>.mmproj.gguf) and external MTP sidecars are not main models
  local f
  for f in "$MODELS_DIR"/*.gguf(N); do
    [[ "${f:t}" == mmproj* || "${f:t}" == *.mmproj.gguf || "${f:t}" == *FastMTP* ]] && continue
    echo "$f"
  done
}

running_model() {
  server_up && curl -s "$URL/props" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("model_path",""))' 2>/dev/null
}

choose_model() {
  local models=("${(@f)$(list_models)}")
  [[ -z "${models[1]:-}" ]] && { echo "No models found. Download one: claude-qwen download <hf-repo>" >&2; exit 1; }
  local running="$(running_model)" pick="${QWEN_MODEL:-}" i def=1
  for i in {1..${#models}}; do [[ "${models[$i]}" == "$running" ]] && def=$i; done
  if [[ -z "$pick" ]]; then
    if (( ${#models} == 1 )); then
      pick=1
    else
      echo "Which model?"
      for i in {1..${#models}}; do
        local tag=""; [[ -f "${models[$i]:r}.mmproj.gguf" ]] && tag="  [vision]"
        [[ "${models[$i]}" == "$running" ]] && tag="$tag  [running]"
        printf "  %d) %s  (%s)%s\n" $i "${models[$i]:t:r}" "$(human $(stat -f%z "${models[$i]}"))" "$tag"
      done
      read "pick?Choice [$def]: "
      [[ -z "$pick" ]] && pick=$def
    fi
  fi
  if [[ "$pick" == <-> ]]; then
    (( pick >= 1 && pick <= ${#models} )) || { echo "Invalid choice: $pick" >&2; exit 1; }
    MODEL="${models[$pick]}"
  else
    MODEL="$MODELS_DIR/${pick:t}"; [[ "$MODEL" == *.gguf ]] || MODEL="$MODEL.gguf"
  fi
  if [[ -n "$running" && "$running" != "$MODEL" ]]; then
    local others=0 f
    mkdir -p "$SESSIONS"
    for f in "$SESSIONS"/*(N); do kill -0 "${f:t}" 2>/dev/null && others=$((others+1)) || rm -f "$f"; done
    if (( others > 0 )); then
      read "yn?$others open session(s) use another model; switching will move them to the new model too. Continue? [y/N]: "
      [[ "$yn" == [yY]* ]] || exit 1
    fi
    stop_server
  fi
}

download() {
  local repo="${1:-}" file="${2:-}"
  [[ -z "$repo" ]] && read "repo?Hugging Face repo (e.g. unsloth/Qwen3.8-27B-GGUF): "
  repo="${repo#https://huggingface.co/}"; repo="${repo%%/tree/*}"; repo="${repo%/}"
  [[ "$repo" == */* ]] || { echo "Invalid repo: $repo" >&2; exit 1; }
  if [[ -z "$file" ]]; then
    local listing
    listing="$(curl -sf "https://huggingface.co/api/models/$repo/tree/main?recursive=true" | python3 -c '
import json,sys
for f in json.load(sys.stdin):
    p=f["path"]
    if any(c in p for c in "\t\n\r") or not isinstance(f.get("size",0),int): continue
    if p.endswith(".gguf") and "mmproj" not in p.lower() and "fastmtp" not in p.lower():
        print(str(f.get("size",0))+"\t"+p)' | sort -n)"
    [[ -z "$listing" ]] && { echo "Could not read the repo, or it has no GGUF files: $repo" >&2; exit 1; }
    local lines=("${(@f)listing}") i size p fit
    echo "RAM: $(( RAM_MB / 1024 )) GB (leave ~6 GB for context + OS)"
    for i in {1..${#lines}}; do
      size="${lines[$i]%%$'\t'*}"; p="${lines[$i]#*$'\t'}"
      [[ "$size" == <-> ]] || size=0
      fit="fits"; (( size / 1048576 > RAM_MB - 6144 )) && fit="TOO BIG"
      [[ -f "$MODELS_DIR/${p:t}" ]] && fit="downloaded"
      printf "  %2d) %-70s %8s  %s\n" $i "$p" "$(human $size)" "$fit"
    done
    local pick; read "pick?Which one? (number): "
    [[ "$pick" == <-> ]] && (( pick >= 1 && pick <= ${#lines} )) || { echo "Invalid choice." >&2; exit 1; }
    file="${lines[$pick]#*$'\t'}"
  fi
  mkdir -p "$MODELS_DIR"
  local out="$MODELS_DIR/${file:t}"
  fetch "$repo" "$file" "$out" || exit 1
  # Offer the vision projector (enables image input in Claude Code)
  local proj
  proj="$(curl -sf "https://huggingface.co/api/models/$repo/tree/main?recursive=true" | python3 -c '
import json,sys
fs=[f["path"] for f in json.load(sys.stdin) if "mmproj" in f["path"].lower() and f["path"].endswith(".gguf") and not any(c in f["path"] for c in "\t\n\r")]
fs.sort(key=lambda p: (0 if "f16" in p.lower() and "bf16" not in p.lower() else 1 if "bf16" in p.lower() else 2, p))
print(fs[0] if fs else "")')"
  if [[ -n "$proj" && ! -f "${out:r}.mmproj.gguf" ]]; then
    local yn; read "yn?This repo has a vision projector ($proj, ~1 GB) for image input. Download it? [Y/n]: "
    [[ "$yn" == [nN]* ]] || fetch "$repo" "$proj" "${out:r}.mmproj.gguf" || exit 1
  fi
}

fetch() {  # fetch <repo> <file> <out>; -C - resumes an interrupted download
  echo "Downloading: $1/$2 -> $3"
  if curl -fL -C - --retry 5 --progress-bar -o "$3.part" "https://huggingface.co/$1/resolve/main/$2"; then
    mv "$3.part" "$3" && echo "Done: ${3:t}"
  else
    echo "Download interrupted; run the same command again to resume." >&2; return 1
  fi
}

setup() {
  command -v brew >/dev/null || { echo "Homebrew is required: https://brew.sh" >&2; exit 1; }
  command -v llama-server >/dev/null || brew install llama.cpp
  command -v claude >/dev/null || echo "Claude Code not found: https://code.claude.com"
  if [[ "$DIR" != */Cellar/* ]]; then
    mkdir -p "$HOME/.local/bin" && ln -sf "$DIR/claude-qwen" "$HOME/.local/bin/claude-qwen"
    echo "claude-qwen -> ~/.local/bin/claude-qwen (make sure this directory is on your PATH)"
  fi
  echo "Data directory: $DATA"
  echo
  echo "Optional (for MTP / large contexts): to let claude-qwen raise the GPU memory limit"
  echo "without a password while the server runs, run this in a SEPARATE terminal:"
  echo
  echo "  echo '$(sudoers_rule)' | sudo tee /etc/sudoers.d/claude-qwen.tmp >/dev/null && sudo chmod 440 /etc/sudoers.d/claude-qwen.tmp && sudo visudo -cf /etc/sudoers.d/claude-qwen.tmp && sudo mv /etc/sudoers.d/claude-qwen.tmp /etc/sudoers.d/claude-qwen"
  echo
  list_models | grep -q . || echo "To download a model: claude-qwen download unsloth/Qwen3.8-27B-GGUF"
}

case "${1:-}" in
  stop)     stop_server; exit 0 ;;
  start)    choose_model; start_server; exit 0 ;;
  restart)  QWEN_MODEL="${QWEN_MODEL:-$(running_model)}"; stop_server; choose_model; start_server; exit 0 ;;
  status)   server_up && echo "Running: $URL ($(running_model))" || echo "Stopped"; exit 0 ;;
  log)      exec tail -f "$LOG" ;;
  models)   list_models | while read -r f; do echo "${f:t}  ($(human $(stat -f%z "$f")))"; done; exit 0 ;;
  download) shift; download "$@"; exit $? ;;
  setup)    setup; exit 0 ;;
  version|--version) echo "claude-qwen $VERSION"; exit 0 ;;
  providers) echo "Config: $PROVIDERS_FILE"; list_providers | awk '{print "  "$1"  "$2"  ("$3")"}'; exit 0 ;;
esac

BACKEND="$(choose_backend)" || exit 1
if [[ "$BACKEND" != local ]]; then
  launch_remote ${=BACKEND} "$@"
fi

choose_model
start_server

# Session tracking: stop the server when the last session exits (frees RAM, restores the GPU limit).
mkdir -p "$SESSIONS"
touch "$SESSIONS/$$"
cleanup() {
  rm -f "$SESSIONS/$$"
  local f
  for f in "$SESSIONS"/*(N); do kill -0 "${f:t}" 2>/dev/null || rm -f "$f"; done
  if [[ -z "$(ls -A "$SESSIONS")" && "${QWEN_KEEP:-0}" != 1 ]]; then stop_server >/dev/null; fi
}
trap cleanup EXIT INT TERM

ANTHROPIC_BASE_URL="$URL" \
ANTHROPIC_AUTH_TOKEN="local" \
ANTHROPIC_MODEL="$ALIAS" \
ANTHROPIC_DEFAULT_OPUS_MODEL="$ALIAS" \
ANTHROPIC_DEFAULT_SONNET_MODEL="$ALIAS" \
ANTHROPIC_DEFAULT_HAIKU_MODEL="$ALIAS" \
CLAUDE_CODE_SUBAGENT_MODEL="$ALIAS" \
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
API_TIMEOUT_MS=3000000 \
CLAUDE_CODE_AUTO_COMPACT_WINDOW=100000 \
  claude "$@"
