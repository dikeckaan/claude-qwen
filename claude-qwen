#!/bin/zsh
# claude-qwen: Claude Code'u yerel bir GGUF modeliyle (llama.cpp / llama-server) çalıştırır.
#
#   claude-qwen [claude argümanları]    model seç, sunucuyu gerekirse başlat, Claude Code'u aç
#   claude-qwen download [repo] [dosya] Hugging Face'ten GGUF indir (repo vermezsen sorar)
#   claude-qwen models                  indirilmiş modelleri listele
#   claude-qwen setup                   llama.cpp kur, komutu PATH'e bağla, sudo kuralını göster
#   claude-qwen stop | status | log     sunucuyu durdur / durum / logu izle
#
# Ortam değişkenleri:
#   QWEN_MODEL=<no|dosya-adı>  menüyü atla           QWEN_CTX=102400   bağlam boyutu
#   QWEN_EFFORT=medium         xhigh|medium|low|none  QWEN_MTP=0|1      MTP spekülatif çözme
#   QWEN_KEEP=1                oturum kapanınca sunucuyu açık tut
#   QWEN_GPU_MB=<MB>           sunucu açıkken iogpu.wired_limit_mb (varsayılan: RAM'in 7/8'i)
#   QWEN_PORT=8088             QWEN_EXTRA="..." ek llama-server argümanları
set -u

DIR="${0:A:h}"
MODELS_DIR="$DIR/models"
PORT="${QWEN_PORT:-8088}"
CTX="${QWEN_CTX:-102400}"
EFFORT="${QWEN_EFFORT:-medium}"
MTP="${QWEN_MTP:-0}"
PIDFILE="$DIR/server.pid"
LOG="$DIR/server.log"
SESSIONS="$DIR/sessions"
URL="http://127.0.0.1:$PORT"
ALIAS="local-model"
RAM_MB=$(( $(sysctl -n hw.memsize) / 1048576 ))
GPU_MB="${QWEN_GPU_MB:-$(( RAM_MB * 7 / 8 ))}"

server_up() { curl -sf "$URL/health" >/dev/null 2>&1; }
human() { [[ "$1" == <-> ]] && awk -v n="$1" 'BEGIN{printf "%.1f GB", n/1e9}' || echo "?"; }

# --- GPU bellek sınırı (sudoers kuralı varsa şifresiz) ---------------------
gpu_limit() { sudo -n /usr/sbin/sysctl "iogpu.wired_limit_mb=$1" >/dev/null 2>&1; }
sudoers_rule() {
  echo "$(whoami) ALL=(root) NOPASSWD: /usr/sbin/sysctl iogpu.wired_limit_mb=$GPU_MB, /usr/sbin/sysctl iogpu.wired_limit_mb=0"
}

# --- Sunucu ----------------------------------------------------------------
stop_server() {
  local pid=""
  [[ -f "$PIDFILE" ]] && pid="$(cat "$PIDFILE")"
  kill -0 "$pid" 2>/dev/null || pid="$(pgrep -f "llama-server.*--port $PORT" | head -1)"
  if [[ -n "$pid" ]]; then
    kill "$pid"
    for i in {1..10}; do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid"
    echo "Sunucu durduruldu."
    gpu_limit 0
  else
    echo "Çalışan sunucu yok."
  fi
  rm -f "$PIDFILE"
}

start_server() {
  server_up && return 0
  [[ -f "$MODEL" ]] || { echo "Model bulunamadı: $MODEL" >&2; exit 1; }
  command -v llama-server >/dev/null || { echo "llama-server yok. Önce: claude-qwen setup" >&2; exit 1; }
  if ! gpu_limit "$GPU_MB"; then
    [[ "$MTP" == 1 ]] && echo "Uyarı: GPU bellek sınırı yükseltilemedi (bkz. claude-qwen setup); MTP kapatıldı." >&2
    MTP=0
  fi
  local extra=()
  [[ "$MTP" == 1 ]] && extra+=(--spec-type draft-mtp --spec-draft-n-max 3)
  # Qwen3.8 şablonu Claude Code'un konuşma ortası system mesajlarını reddediyor; yamalı şablonu kullan.
  [[ "${MODEL:t}" == *[Qq]wen3.8* && -f "$DIR/chat_template.jinja" ]] && extra+=(--chat-template-file "$DIR/chat_template.jinja")
  echo "${MODEL:t} yükleniyor (~30-60 sn)..."
  nohup llama-server \
    -m "$MODEL" --alias "$ALIAS" \
    --host 127.0.0.1 --port "$PORT" \
    -ngl 99 -c "$CTX" -fa on -ctk q8_0 -ctv q8_0 \
    --jinja --reasoning-effort "$EFFORT" \
    --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0 \
    --parallel 1 "${extra[@]}" ${=QWEN_EXTRA:-} \
    >"$LOG" 2>&1 &
  echo $! >"$PIDFILE"
  for i in {1..300}; do
    server_up && { echo "Sunucu hazır ($URL)."; return 0; }
    kill -0 "$(cat "$PIDFILE")" 2>/dev/null || { echo "Sunucu çöktü, log: $LOG" >&2; tail -20 "$LOG" >&2; gpu_limit 0; exit 1; }
    sleep 1
  done
  echo "Sunucu zaman aşımı, log: $LOG" >&2; exit 1
}

# --- Modeller --------------------------------------------------------------
list_models() {
  # mmproj (görsel) ve harici MTP sidecar dosyaları ana model değildir
  local f
  for f in "$MODELS_DIR"/*.gguf(N); do
    [[ "${f:t}" == mmproj* || "${f:t}" == *FastMTP* ]] && continue
    echo "$f"
  done
}

running_model() {
  server_up && curl -s "$URL/props" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("model_path",""))' 2>/dev/null
}

choose_model() {
  local models=("${(@f)$(list_models)}")
  [[ -z "${models[1]:-}" ]] && { echo "Hiç model yok. İndir: claude-qwen download <hf-repo>" >&2; exit 1; }
  local running="$(running_model)" pick="${QWEN_MODEL:-}" i def=1
  for i in {1..${#models}}; do [[ "${models[$i]}" == "$running" ]] && def=$i; done
  if [[ -z "$pick" ]]; then
    if (( ${#models} == 1 )); then
      pick=1
    else
      echo "Hangi model?"
      for i in {1..${#models}}; do
        local tag=""; [[ "${models[$i]}" == "$running" ]] && tag="  [şu an açık]"
        printf "  %d) %s  (%s)%s\n" $i "${models[$i]:t:r}" "$(human $(stat -f%z "${models[$i]}"))" "$tag"
      done
      read "pick?Seçim [$def]: "
      [[ -z "$pick" ]] && pick=$def
    fi
  fi
  if [[ "$pick" == <-> ]]; then
    (( pick >= 1 && pick <= ${#models} )) || { echo "Geçersiz seçim: $pick" >&2; exit 1; }
    MODEL="${models[$pick]}"
  else
    MODEL="$MODELS_DIR/${pick:t}"; [[ "$MODEL" == *.gguf ]] || MODEL="$MODEL.gguf"
  fi
  if [[ -n "$running" && "$running" != "$MODEL" ]]; then
    local others=0 f
    mkdir -p "$SESSIONS"
    for f in "$SESSIONS"/*(N); do kill -0 "${f:t}" 2>/dev/null && others=$((others+1)) || rm -f "$f"; done
    if (( others > 0 )); then
      read "yn?Açık $others oturum başka modeli kullanıyor; değiştirirsem onlar da yeni modele geçer. Devam? [e/H]: "
      [[ "$yn" == [eEyY]* ]] || exit 1
    fi
    stop_server
  fi
}

download() {
  local repo="${1:-}" file="${2:-}"
  [[ -z "$repo" ]] && read "repo?Hugging Face repo (örn. unsloth/Qwen3.8-27B-GGUF): "
  repo="${repo#https://huggingface.co/}"; repo="${repo%%/tree/*}"; repo="${repo%/}"
  [[ "$repo" == */* ]] || { echo "Geçersiz repo: $repo" >&2; exit 1; }
  if [[ -z "$file" ]]; then
    local listing
    listing="$(curl -sf "https://huggingface.co/api/models/$repo/tree/main?recursive=true" | python3 -c '
import json,sys
for f in json.load(sys.stdin):
    p=f["path"]
    if any(c in p for c in "\t\n\r") or not isinstance(f.get("size",0),int): continue
    if p.endswith(".gguf") and "mmproj" not in p.lower() and "fastmtp" not in p.lower():
        print(str(f.get("size",0))+"\t"+p)' | sort -n)"
    [[ -z "$listing" ]] && { echo "Repo okunamadı ya da GGUF dosyası yok: $repo" >&2; exit 1; }
    local lines=("${(@f)listing}") i size p fit
    echo "RAM: $(( RAM_MB / 1024 )) GB (bağlam + sistem için ~6 GB pay bırak)"
    for i in {1..${#lines}}; do
      size="${lines[$i]%%$'\t'*}"; p="${lines[$i]#*$'\t'}"
      [[ "$size" == <-> ]] || size=0
      fit="sığar"; (( size / 1048576 > RAM_MB - 6144 )) && fit="BÜYÜK"
      [[ -f "$MODELS_DIR/${p:t}" ]] && fit="indirildi"
      printf "  %2d) %-70s %8s  %s\n" $i "$p" "$(human $size)" "$fit"
    done
    local pick; read "pick?Hangisi? (no): "
    [[ "$pick" == <-> ]] && (( pick >= 1 && pick <= ${#lines} )) || { echo "Geçersiz seçim." >&2; exit 1; }
    file="${lines[$pick]#*$'\t'}"
  fi
  mkdir -p "$MODELS_DIR"
  local out="$MODELS_DIR/${file:t}"
  echo "İndiriliyor: $repo/$file -> $out"
  # -C - : yarıda kalırsa aynı komut kaldığı yerden devam eder
  if curl -fL -C - --retry 5 --progress-bar -o "$out.part" "https://huggingface.co/$repo/resolve/main/$file"; then
    mv "$out.part" "$out" && echo "Tamam: ${out:t}"
  else
    echo "İndirme yarıda kaldı; aynı komutu tekrar çalıştırırsan devam eder." >&2; exit 1
  fi
}

setup() {
  command -v brew >/dev/null || { echo "Homebrew gerekli: https://brew.sh" >&2; exit 1; }
  command -v llama-server >/dev/null || brew install llama.cpp
  command -v claude >/dev/null || echo "Claude Code bulunamadı: https://code.claude.com"
  mkdir -p "$HOME/.local/bin" && ln -sf "$DIR/claude-qwen" "$HOME/.local/bin/claude-qwen"
  echo "claude-qwen -> ~/.local/bin/claude-qwen (bu klasör PATH'te olmalı)"
  echo
  echo "İsteğe bağlı (MTP / büyük bağlam için): sunucu açıkken GPU bellek sınırını şifresiz"
  echo "yükseltebilmek için AYRI bir terminalde şunu çalıştır:"
  echo
  echo "  echo '$(sudoers_rule)' | sudo tee /etc/sudoers.d/claude-qwen.tmp >/dev/null && sudo chmod 440 /etc/sudoers.d/claude-qwen.tmp && sudo visudo -cf /etc/sudoers.d/claude-qwen.tmp && sudo mv /etc/sudoers.d/claude-qwen.tmp /etc/sudoers.d/claude-qwen"
  echo
  list_models | grep -q . || echo "Model indirmek için: claude-qwen download unsloth/Qwen3.8-27B-GGUF"
}

case "${1:-}" in
  stop)     stop_server; exit 0 ;;
  status)   server_up && echo "Çalışıyor: $URL ($(running_model))" || echo "Kapalı"; exit 0 ;;
  log)      exec tail -f "$LOG" ;;
  models)   list_models | while read -r f; do echo "${f:t}  ($(human $(stat -f%z "$f")))"; done; exit 0 ;;
  download) shift; download "$@"; exit $? ;;
  setup)    setup; exit 0 ;;
esac

choose_model
start_server

# Oturum takibi: son oturum kapanınca sunucuyu kapat (RAM'i ve GPU sınırını geri ver).
mkdir -p "$SESSIONS"
touch "$SESSIONS/$$"
cleanup() {
  rm -f "$SESSIONS/$$"
  local f
  for f in "$SESSIONS"/*(N); do kill -0 "${f:t}" 2>/dev/null || rm -f "$f"; done
  if [[ -z "$(ls -A "$SESSIONS")" && "${QWEN_KEEP:-0}" != 1 ]]; then stop_server >/dev/null; fi
}
trap cleanup EXIT INT TERM

ANTHROPIC_BASE_URL="$URL" \
ANTHROPIC_AUTH_TOKEN="local" \
ANTHROPIC_MODEL="$ALIAS" \
ANTHROPIC_DEFAULT_OPUS_MODEL="$ALIAS" \
ANTHROPIC_DEFAULT_SONNET_MODEL="$ALIAS" \
ANTHROPIC_DEFAULT_HAIKU_MODEL="$ALIAS" \
CLAUDE_CODE_SUBAGENT_MODEL="$ALIAS" \
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
API_TIMEOUT_MS=3000000 \
CLAUDE_CODE_AUTO_COMPACT_WINDOW=100000 \
  claude "$@"
